# Copy to .env.local for `vercel dev`, and add the same names in Vercel → Settings → Environment Variables.
OPENCODE_API_KEY=oc_sk_your_key_here
# Optional: a passphrase visitors must enter once before asking (protects your key's budget on a public site)
ACCESS_CODE=
# Optional: model (default zen:deepseek-v4.1-flash = Zen credits). Comma-separated list = fallbacks; no "zen:" prefix = Go subscription.
OPENCODE_MODELS=zen:deepseek-v4.1-flash

# Optional: best-effort per-IP limits (per warm serverless instance)
RATE_LIMIT_PER_MIN=12
RATE_LIMIT_PER_DAY=300
